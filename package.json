{
  "name": "repsec",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:app": "vite build --watch",
    "build": "rm -rf dist && mkdir -p dist && cp -R public/. dist/ && vite build",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.11.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.68.1"
  }
}
